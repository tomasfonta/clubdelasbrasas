# Clave del panel admin (obligatoria en producción)
ADMIN_PASSWORD=123456
# Ruta "secreta" del panel (sin barra). El panel queda en /<ADMIN_PATH>
ADMIN_PATH=admin
# Firma de la cookie de sesión (cadena larga aleatoria)
SESSION_SECRET=
# URL pública. Se usa para generar los QR: ponla ANTES de imprimirlos.
BASE_URL=http://localhost:3000
# Número inicial de WhatsApp (luego se edita en Ajustes)
WHATSAPP_NUMBER=34600000000
# Ruta del fichero SQLite (en Render, dentro del disco persistente)
DATABASE_PATH=./data/brasas.db
PORT=3000
